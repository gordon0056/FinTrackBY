<UserControl x:Class="FinTrackBY.Views.ConverterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <GroupBox Header="Конвертер" Margin="2">
        <StackPanel Margin="5">
            <DockPanel Margin="0,0,0,3">
                <TextBlock Text="Сколько:" VerticalAlignment="Center" DockPanel.Dock="Left" Margin="0,0,5,0" />
                <TextBox Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged}"
                         DockPanel.Dock="Right" Width="90" Margin="5,0,0,0" />
                <ComboBox ItemsSource="{Binding AvailableCurrencies}"
                          SelectedItem="{Binding SelectedFromCurrency, Mode=TwoWay}"
                          Width="110">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Cur_Abbreviation}" Margin="4,2" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </DockPanel>
            <DockPanel Margin="0,3,0,3">
                <TextBlock Text="В:" VerticalAlignment="Center" DockPanel.Dock="Left" Margin="0,0,5,0" />
                <ComboBox ItemsSource="{Binding AvailableCurrencies}"
                          SelectedItem="{Binding SelectedToCurrency, Mode=TwoWay}"
                          Width="110">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Cur_Abbreviation}" Margin="4,2" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </DockPanel>
            <TextBlock Margin="0,5,0,0" FontSize="18" FontWeight="Bold" Text="{Binding ResultText}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource FallBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
        </StackPanel>
    </GroupBox>
</UserControl>