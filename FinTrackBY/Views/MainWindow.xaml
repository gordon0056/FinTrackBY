<Window x:Class="FinTrackBY.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:FinTrackBY.Views"
        Title="NBRB Rates Viewer" Width="1200" Height="800"
        Background="{DynamicResource BackgroundBrush}">
    <Grid x:Name="_rootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        
        <DockPanel Grid.Row="0" Background="{DynamicResource PanelBrush}">
            <Menu DockPanel.Dock="Left" Background="{DynamicResource PanelBrush}">
                <MenuItem Header="Файл">
                    <MenuItem Header="Открыть файл…" Command="{Binding OpenFileCommand}" />
                    <MenuItem Header="Сохранить как…" Command="{Binding SaveFileCommand}" />
                    <Separator />
                    <MenuItem Header="Загрузить данные за период…" Command="{Binding LoadHistoryCommand}" />
                </MenuItem>
            </Menu>
            <Button Content="🌙 Тема" Command="{Binding ToggleThemeCommand}"
                    HorizontalAlignment="Right" Margin="10,2" Padding="8,2" />
        </DockPanel>

        
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="480" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            
            <views:ConverterView Grid.Row="0" Grid.Column="0" Margin="5"
                                 DataContext="{Binding ConverterViewModel}" />

            
            <views:CurrentRatesView Grid.Row="1" Grid.Column="0" Margin="5" />

            
            <views:ChartView Grid.Row="0" Grid.Column="1" Grid.RowSpan="2" Margin="5"
                             DataContext="{Binding ChartViewModel}" />
        </Grid>

        
        <StatusBar Grid.Row="2" Background="{DynamicResource PanelBrush}">
            <TextBlock Text="{Binding StatusMessage}" />
        </StatusBar>
    </Grid>
</Window>